{
  "name": "dsh-memory",
  "version": "0.1.0",
  "description": "Long-term memory for dsh that lives in a private GitHub repository: the core memory is injected into every conversation, the rest is searched on demand, and every machine pulls and pushes the same notes.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-tools": ">=0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.2-rc.1"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "github",
    "sync"
  ],
  "license": "MIT"
}
